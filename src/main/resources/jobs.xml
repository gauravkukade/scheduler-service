<?xml version="1.0" encoding="UTF-8"?>
<job-scheduling-data xmlns="http://www.quartz-scheduler.org/xml/JobSchedulingData" version="2.0">
    <processing-directives>
        <overwrite-existing-data>true</overwrite-existing-data>
    </processing-directives>
    <schedule>
        <job>
            <name>TradeReportingMurexEquityEmeaUkJob</name>
            <group>TradeReporting</group>
            <job-class>com.coderolls.jobplatform.schedulerservice.quartz.JobDispatcher</job-class>
            <job-data-map>
                <entry>
                    <key>concurrencyPolicy</key>
                    <value>SINGLE_INSTANCE</value>
                </entry>
                <entry>
                    <key>misfirePolicy</key>
                    <value>FIRE_NOW</value>
                </entry>
                <entry>
                    <key>maxRetryAttempts</key>
                    <value>3</value>
                </entry>
                <entry>
                    <key>retryBackoffSeconds</key>
                    <value>30</value>
                </entry>
                <entry>
                    <key>timeoutSeconds</key>
                    <value>600</value>
                </entry>
                <entry>
                    <key>nextJobName</key>
                    <value>TradeReportingMurexEquityEmeaUkFileGenerationJob</value>
                </entry>
                <entry>
                    <key>nextJobGroup</key>
                    <value>TradeReporting</value>
                </entry>
            </job-data-map>
        </job>
        <trigger>
            <cron>
                <name>TradeReportingMurexEquityEmeaUkTrigger</name>
                <job-name>TradeReportingMurexEquityEmeaUkJob</job-name>
                <job-group>TradeReporting</job-group>
                <cron-expression>0 0 6 * * ?</cron-expression>
            </cron>
        </trigger>
    </schedule>
</job-scheduling-data>